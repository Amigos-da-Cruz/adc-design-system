{
  "name": "@amigos-da-cruz/adc-design-system",
  "version": "0.1.0",
  "description": "Design system dos Amigos da Cruz: tokens, componentes React e Storybook.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amigos-da-Cruz/adc-design-system.git"
  },
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/adc-design-system.js"
    },
    "./style.css": "./dist/adc-design-system.css"
  },
  "sideEffects": ["**/*.css"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && storybook dev -p 6006",
    "build": "npm run tokens && npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "build-storybook": "npm run tokens && storybook build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
